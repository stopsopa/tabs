{
  "name": "stopsopa-tabs",
  "private": true,
  "version": "0.0.0",
  "description": "Declarative, dependency free tabs for raw html (vanilla js) + React component. Not an npm package: files are copied to projects, see README.md",
  "type": "module",
  "scripts": {
    "transpile": "/bin/bash transpile.sh",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "style:check": "prettier --config prettier.config.cjs --check .",
    "style:fix": "prettier --config prettier.config.cjs --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stopsopa/tabs.git"
  },
  "keywords": [
    "tabs",
    "vanilla",
    "vanilla-js",
    "esm",
    "typescript",
    "react",
    "no-dependencies"
  ],
  "author": "Szymon Działowski",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/stopsopa/tabs/issues"
  },
  "homepage": "https://stopsopa.github.io/tabs/",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.11",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "29.1.1",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
